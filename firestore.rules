rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Students collection - allows direct persistence of student records
    match /students/{studentId} {
      allow read, write: if true;
    }

    // School settings profile
    match /schools/{schoolId} {
      allow read, write: if true;
    }

    // Class records
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Examinations
    match /exams/{examId} {
      allow read, write: if true;
    }

    // Date sheets (Timetable)
    match /dateSheets/{dateSheetId} {
      allow read, write: if true;
    }

    // Exam Instructions
    match /instructions/{instructionId} {
      allow read, write: if true;
    }

    // App & Design Settings (Design, Visibility, Print Settings, Custom Fields)
    match /app_settings/{settingsId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
